# Supabase PostgreSQL. URL-encode the database password before inserting it.
# Runtime connection: shared transaction pooler.
DATABASE_URL="postgresql://inventory_app.nmkscynewleihhopfoog:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&sslcert=certs/supabase-prod-ca-2021.crt&sslaccept=strict&connect_timeout=15&connection_limit=5&pool_timeout=20"
# Prisma migrations: shared session pooler (IPv4).
DIRECT_URL="postgresql://inventory_app.nmkscynewleihhopfoog:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&sslcert=certs/supabase-prod-ca-2021.crt&sslaccept=strict&connect_timeout=15"

NEXT_PUBLIC_SUPABASE_URL="https://nmkscynewleihhopfoog.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Inventory queries use server-side Prisma; login uses NextAuth.
# The public Supabase key does not replace the PostgreSQL password.
NEXTAUTH_SECRET="generate-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"
