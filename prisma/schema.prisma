// Prisma schema - PostgreSQL for Supabase / Vercel
// QR Inventory & Physical Stocktaking System

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS & SECURITY ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  nameAr        String?
  role          String    @default("STOCK_COUNTER")
  isActive      Boolean   @default(true)
  locale        String    @default("ar")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  createdItems          Item[]              @relation("ItemCreatedBy")
  stockMovements        StockMovement[]     @relation("MovementCreatedBy")
  approvedMovements     StockMovement[]     @relation("MovementApprovedBy")
  stocktakeSessions     StocktakeSession[]  @relation("SessionCreatedBy")
  countTasks            CountTask[]         @relation("TaskAssignedTo")
  countRecords          CountRecord[]       @relation("CountBy")
  verifications         CountRecord[]       @relation("VerifiedBy")
  adjustments           StockAdjustment[]   @relation("AdjustmentCreatedBy")
  approvedAdjustments   StockAdjustment[]   @relation("AdjustmentApprovedBy")
  auditLogs             AuditLog[]
  scanEvents            ScanEvent[]

  @@index([role])
  @@index([isActive])
}

model Category {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameAr      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       Item[]
}

model Brand {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameAr    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  items     Item[]
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameAr      String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  locations   Location[]
  sessions    StocktakeSession[]
  movementsFrom StockMovement[] @relation("FromWarehouse")
  movementsTo   StockMovement[] @relation("ToWarehouse")
}

model Location {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  zone        String?
  aisle       String?
  shelf       String?
  bin         String?
  code        String
  name        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  cartons     Carton[]
  balances    InventoryBalance[]
  countRecords CountRecord[]
  movementsFrom StockMovement[] @relation("FromLocation")
  movementsTo   StockMovement[] @relation("ToLocation")

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model Item {
  id              String      @id @default(cuid())
  sku             String      @unique
  internalId      String      @unique
  nameEn          String
  nameAr          String
  description     String?
  descriptionAr   String?
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?      @relation(fields: [brandId], references: [id])
  model           String?
  size            String?
  color           String?
  attributes      String?
  sourceType      String
  uom             String      @default("PCS")
  unitsPerCarton  Int         @default(1)
  costPerUnit     Decimal     @default(0)
  currency        String      @default("USD")
  imageUrl        String?
  notes           String?
  isActive        Boolean     @default(true)
  createdById     String?
  createdBy       User?       @relation("ItemCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  batches         Batch[]
  cartons         Carton[]
  balances        InventoryBalance[]
  movementItems   StockMovementItem[]
  countRecords    CountRecord[]
  adjustments     StockAdjustment[]

  @@index([sku])
  @@index([sourceType])
  @@index([isActive])
  @@index([categoryId])
}

model Batch {
  id              String      @id @default(cuid())
  itemId          String
  item            Item        @relation(fields: [itemId], references: [id])
  batchNumber     String
  sourceType      String
  supplierRef     String?
  productionRef   String?
  productionDate  DateTime?
  importDate      DateTime?
  receivingDate   DateTime?
  expiryDate      DateTime?
  notes           String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  cartons         Carton[]
  balances        InventoryBalance[]
  movementItems   StockMovementItem[]
  countRecords    CountRecord[]

  @@unique([itemId, batchNumber])
  @@index([itemId])
  @@index([sourceType])
  @@index([batchNumber])
}

model Carton {
  id              String      @id @default(cuid())
  qrCode          String      @unique
  cartonNumber    String
  itemId          String
  item            Item        @relation(fields: [itemId], references: [id])
  batchId         String
  batch           Batch       @relation(fields: [batchId], references: [id])
  locationId      String?
  location        Location?   @relation(fields: [locationId], references: [id])
  quantity        Decimal
  originalQty     Decimal
  status          String      @default("AVAILABLE")
  serialNumbers   String?
  notes           String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  countRecords    CountRecord[]
  scanEvents      ScanEvent[]
  movementItems   StockMovementItem[]

  @@index([qrCode])
  @@index([itemId])
  @@index([batchId])
  @@index([locationId])
  @@index([status])
  @@index([cartonNumber])
}

model InventoryBalance {
  id              String   @id @default(cuid())
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  batchId         String?
  batch           Batch?   @relation(fields: [batchId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  quantity        Decimal  @default(0)
  reservedQty     Decimal  @default(0)
  damagedQty      Decimal  @default(0)
  quarantinedQty  Decimal  @default(0)
  lastMovementAt  DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([itemId, batchId, locationId])
  @@index([itemId])
  @@index([locationId])
}

model StockMovement {
  id              String          @id @default(cuid())
  movementNumber  String          @unique
  type            String
  reference       String?
  effectiveDate   DateTime
  status          String          @default("DRAFT")
  notes           String?
  fromWarehouseId String?
  fromWarehouse   Warehouse?      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  fromLocationId  String?
  fromLocation    Location?       @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String?
  toLocation      Location?       @relation("ToLocation", fields: [toLocationId], references: [id])
  createdById     String
  createdBy       User            @relation("MovementCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?           @relation("MovementApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           StockMovementItem[]
  adjustments     StockAdjustment[]

  @@index([type])
  @@index([status])
  @@index([effectiveDate])
  @@index([movementNumber])
}

model StockMovementItem {
  id              String        @id @default(cuid())
  movementId      String
  movement        StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  batchId         String?
  batch           Batch?        @relation(fields: [batchId], references: [id])
  cartonId        String?
  carton          Carton?       @relation(fields: [cartonId], references: [id])
  quantity        Decimal
  unitCost        Decimal?
  notes           String?

  @@index([movementId])
  @@index([itemId])
  @@index([cartonId])
}

model StocktakeSession {
  id              String            @id @default(cuid())
  sessionNumber   String            @unique
  type            String
  status          String            @default("DRAFT")
  title           String
  titleAr         String?
  scopeType       String
  scopeJson       String?
  countDate       DateTime
  freezeCutoffAt  DateTime?
  isBlind         Boolean           @default(true)
  isSurprise      Boolean           @default(false)
  isHidden        Boolean           @default(false)
  notes           String?
  createdById     String
  createdBy       User              @relation("SessionCreatedBy", fields: [createdById], references: [id])
  startedAt       DateTime?
  completedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  warehouseId     String?
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id])

  tasks           CountTask[]
  countRecords    CountRecord[]
  snapshots       BookSnapshot[]
  adjustments     StockAdjustment[]
  progress        SessionProgress?

  @@index([type])
  @@index([status])
  @@index([isSurprise, isHidden])
  @@index([sessionNumber])
}

model SessionProgress {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  session         StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  totalTasks      Int      @default(0)
  assignedTasks   Int      @default(0)
  startedTasks    Int      @default(0)
  countedTasks    Int      @default(0)
  verifiedTasks   Int      @default(0)
  pendingTasks    Int      @default(0)
  completedTasks  Int      @default(0)
  totalExpected   Int      @default(0)
  totalCounted    Int      @default(0)
  matchedCount    Int      @default(0)
  shortageCount   Int      @default(0)
  surplusCount    Int      @default(0)
  unknownCount    Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model CountTask {
  id              String      @id @default(cuid())
  sessionId       String
  session         StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedToId    String?
  assignedTo      User?       @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  locationId      String?
  status          String      @default("PENDING")
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime    @default(now())

  countRecords    CountRecord[]

  @@index([sessionId])
  @@index([assignedToId])
  @@index([status])
}

model BookSnapshot {
  id              String   @id @default(cuid())
  sessionId       String
  session         StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId          String
  batchId         String?
  locationId      String?
  bookQuantity    Decimal
  unitCost        Decimal?
  capturedAt      DateTime @default(now())

  @@index([sessionId])
  @@index([itemId])
  @@unique([sessionId, itemId, batchId, locationId])
}

model CountRecord {
  id              String          @id @default(cuid())
  sessionId       String
  session         StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskId          String?
  task            CountTask?      @relation(fields: [taskId], references: [id])
  cartonId        String?
  carton          Carton?         @relation(fields: [cartonId], references: [id])
  itemId          String
  item            Item            @relation(fields: [itemId], references: [id])
  batchId         String?
  batch           Batch?          @relation(fields: [batchId], references: [id])
  locationId      String?
  location        Location?       @relation(fields: [locationId], references: [id])
  qrCodeScanned   String?
  countedQty      Decimal
  bookQty         Decimal?
  varianceQty     Decimal?
  status          String          @default("COUNTED")
  isUnexpected    Boolean         @default(false)
  isUnknownQr     Boolean         @default(false)
  isDuplicate     Boolean         @default(false)
  isWrongLocation Boolean         @default(false)
  isDamaged       Boolean         @default(false)
  isPartial       Boolean         @default(false)
  notes           String?
  clientEventId   String?
  countedById     String
  countedBy       User            @relation("CountBy", fields: [countedById], references: [id])
  countedAt       DateTime        @default(now())
  verifiedById    String?
  verifiedBy      User?           @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  verificationNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([sessionId, cartonId])
  @@index([sessionId])
  @@index([itemId])
  @@index([qrCodeScanned])
  @@index([clientEventId])
  @@index([status])
}

model StockAdjustment {
  id              String            @id @default(cuid())
  adjustmentNumber String           @unique
  sessionId       String?
  session         StocktakeSession? @relation(fields: [sessionId], references: [id])
  movementId      String?
  movement        StockMovement?    @relation(fields: [movementId], references: [id])
  itemId          String
  item            Item              @relation(fields: [itemId], references: [id])
  batchId         String?
  locationId      String?
  bookQty         Decimal
  physicalQty     Decimal
  varianceQty     Decimal
  unitCost        Decimal?
  financialVariance Decimal?
  reason          String
  reasonCode      String?
  status          String            @default("PENDING")
  createdById     String
  createdBy       User              @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?             @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([itemId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  oldValues   String?
  newValues   String?
  reason      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model ScanEvent {
  id            String   @id @default(cuid())
  qrCode        String
  cartonId      String?
  carton        Carton?  @relation(fields: [cartonId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  sessionId     String?
  clientEventId String?
  result        String
  deviceInfo    String?
  scannedAt     DateTime @default(now())
  syncedAt      DateTime?

  @@index([qrCode])
  @@index([clientEventId])
  @@index([sessionId])
  @@index([scannedAt])
}
